# Streamlit Community Cloud Secrets Configuration Example
# In Streamlit Cloud: App Settings -> Secrets
# For local testing: Copy this file to .streamlit/secrets.toml (NEVER commit secrets.toml!)

# Google AI Studio API Key for live AI inference (Gemini 2.0 Flash)
# Obtain a free key at: https://aistudio.google.com/
GEMINI_API_KEY = "YOUR_GEMINI_API_KEY_HERE"

# Optional: Default application mode ('demo' or 'ai')
# If set to 'demo', the app runs 100% offline with 17 deterministic scenarios
# If set to 'ai', the app queries Google Gemini 2.0 Flash
APP_MODE = "demo"

# Optional: Gemini model name (default: gemini-2.0-flash)
GEMINI_MODEL = "gemini-2.0-flash"
